<?xml version="1.0"?>
<ruleset name="AI Elementor AG">
    <description>Modern PHP style baseline for the plugin; WordPress security checks are enforced by focused tests and review.</description>
    <file>src</file>
    <file>tests</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/stubs/*</exclude-pattern>
    <rule ref="PSR12" />
</ruleset>
